#!/bin/sh
#
# This script will be run by OpenVPN on startup via the 'up' configuration
# directive in /etc/openvpn/server.conf.
#
<% if @enable_ip_forwarding -%>
# Turn on IP forwarding
/sbin/sysctl -w net.ipv4.ip_forward=1
<% end -%>

# Set up iptables NAT rules as needed.
# Example:
# /sbin/iptables -t nat -A POSTROUTING -s <%= @subnet %>/<%= @netmask %> -o eth0 -j MASQUERADE

# Run additional startup scripts.
for script in <%= @up_script_dir %>/*.sh; do
    [ -f "$script" ] || continue
    . "$script"
done
